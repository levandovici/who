# MongoDB — Docker compose runs a single-node replica set (rs0) on :27017
# Production (Atlas): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/who
DATABASE_URL="mongodb://localhost:27017/who?replicaSet=rs0&directConnection=true"

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=""

# Lookup tuning
LOOKUP_REGISTRATION_TTL_HOURS="24"
LOOKUP_DNS_TTL_MINUTES="30"
LOOKUP_IP_TTL_HOURS="24"
LOOKUP_TIMEOUT_MS="10000"
