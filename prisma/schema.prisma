generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// MongoDB provider notes:
// - no enums -> String fields; valid values are enforced in app code
//   (Plan: FREE|PRO|BUSINESS, LookupKind: REGISTRATION|DNS|IP,
//    SubscriptionStatus: ACTIVE|TRIALING|PAST_DUE|CANCELED)
// - no onDelete referential actions -> related docs are orphaned on delete
// - no migrations -> `npx prisma db push` syncs indexes/collections
// - ids are ObjectId hex strings (@map("_id"))

// ---------- Auth.js ----------

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  plan          String    @default("FREE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  subscription  Subscription?
  usageEvents   UsageEvent[]
  savedDomains  SavedDomain[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain intelligence ----------

model Domain {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // lowercased, punycode (e.g. "xn--...") — canonical form
  tld       String
  createdAt DateTime @default(now())

  snapshots LookupSnapshot[]
  savedBy   SavedDomain[]

  @@index([tld])
}

// Append-only history. Each lookup (registration/dns/ip) that returns a
// changed payload inserts a new document — history and diffs come free.
model LookupSnapshot {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  domainId  String   @db.ObjectId
  kind      String   // REGISTRATION | DNS | IP
  source    String   // e.g. "rdap:https://rdap.verisign.com", "whois:whois.nic.io", "system-dns"
  payload   String   // normalized result, JSON-serialized (Json type unsupported on mongodb)
  hash      String   // sha256 of canonical payload — dedupe
  fetchedAt DateTime @default(now())
  ttlUntil  DateTime // serve from cache until this instant

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([domainId, kind, fetchedAt])
  @@index([ttlUntil])
}

// ---------- API product ----------

model ApiKey {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  name       String
  prefix     String    // first chars shown in UI, e.g. "who_live_a3f9"
  keyHash    String    @unique // sha256 — raw key never stored
  rateLimit  Int       @default(60) // requests/minute
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id])
  usageEvents UsageEvent[]

  @@index([userId])
}

model UsageEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  apiKeyId  String?  @db.ObjectId
  endpoint  String // e.g. "/api/v1/domain/example.com"
  domain    String?
  status    Int
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id])

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
}

// ---------- Billing (schema-first; provider wired later) ----------

model Subscription {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  plan               String
  status             String   @default("ACTIVE")
  provider           String?  // "lemonsqueezy" | "paddle" | "nowpayments" | ...
  providerCustomerId String?
  providerSubId      String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SavedDomain {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  domainId  String   @db.ObjectId
  notifyOn  String   @default("expiry,change") // comma-separated alert topics
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  domain Domain @relation(fields: [domainId], references: [id])

  @@unique([userId, domainId])
}
